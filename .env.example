# Application
API_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEFAULT_ADMIN_PASSWORD=Admin@123
INITIAL_FARM_NAME=Fazenda Dev/Teste TeleDis
INITIAL_FARM_CODE=DEV-TEST-001

# PostgreSQL
POSTGRES_DB=teledis
POSTGRES_USER=teledis
POSTGRES_PASSWORD=teledis_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgresql+psycopg://teledis:teledis_password@postgres:5432/teledis

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=teledis
MQTT_PASSWORD=teledis_mqtt
MQTT_CLIENT_ID=teledis-api

# Services
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:80
RATE_LIMIT_PER_MINUTE=60

# Monitoring
LOG_LEVEL=INFO

# Route engine (meters and deterministic severity multipliers)
ROUTE_SNAP_MAX_DISTANCE_M=100
ROUTE_DEVIATION_TOLERANCE_METERS=25
OPERATIONAL_PROXIMITY_DEFAULT_METERS=500
OPERATIONAL_PROXIMITY_MAX_METERS=10000
ROUTE_PROBLEM_SEGMENT_TOLERANCE_M=1
ROUTE_PENALTY_LOW=1.10
ROUTE_PENALTY_MEDIUM=1.30
ROUTE_PENALTY_HIGH=1.70
ROUTE_PENALTY_CRITICAL=3.00
