# Application
API_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEFAULT_ADMIN_PASSWORD=Admin@123

# PostgreSQL
POSTGRES_DB=teledis
POSTGRES_USER=teledis
POSTGRES_PASSWORD=teledis_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgresql+psycopg://teledis:teledis_password@postgres:5432/teledis

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=teledis
MQTT_PASSWORD=teledis_mqtt
MQTT_CLIENT_ID=teledis-api

# Services
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:80
RATE_LIMIT_PER_MINUTE=60

# Monitoring
LOG_LEVEL=INFO
